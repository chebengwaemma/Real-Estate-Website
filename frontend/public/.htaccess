# Hostinger / Apache — same API paths as localhost Vite, then SPA fallback
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Match localhost Vite routes: /api/create-checkout-session → PHP
  RewriteRule ^api/create-checkout-session/?$ api/create-checkout-session.php [L,QSA]
  RewriteRule ^api/finalize-paid-registration/?$ api/finalize-paid-registration.php [L,QSA]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Cache hashed Vite assets
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|jpeg|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
