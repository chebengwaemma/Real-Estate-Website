{
  "name": "hopeland-global-checkers",
  "private": true,
  "version": "0.0.0",
  "description": "Hopeland Global Checkers — frontend (Vite/React) + backend (Supabase)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
